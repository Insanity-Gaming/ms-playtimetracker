<Project>

  <Target Name="CopyPluginOutput" AfterTargets="Build" Condition="'$(IsSharedPackage)' != 'true'">

    <PropertyGroup>
      <PluginOutput>$(MSBuildProjectDirectory)/game/sharp/modules/$(AssemblyName)/</PluginOutput>
      <SharedOutputRoot>$(MSBuildProjectDirectory)/game/sharp/shared/</SharedOutputRoot>
    </PropertyGroup>

    <!-- Shared interface assemblies deploy to game/sharp/shared/<AssemblyName>/, not the module folder. -->
    <ItemGroup>
      <SharedDlls Include="$(TargetDir)*.Shared.dll" />
    </ItemGroup>

    <ItemGroup>
      <PluginFiles Include="$(TargetDir)*.dll" Exclude="@(SharedDlls)" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).deps.json" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <MakeDir Directories="$(PluginOutput)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginOutput)" SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(SharedDlls)"
          DestinationFolder="$(SharedOutputRoot)%(Filename)/"
          SkipUnchangedFiles="true" />

  </Target>

</Project>
